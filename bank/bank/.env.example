# Copy this file to .env and change every password before local use.
DB_URL=jdbc:mysql://localhost:3306/minibanckito?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=banckito
DB_PASSWORD=local-banckito-password-change-me
DB_ROOT_PASSWORD=local-root-password-change-me
MYSQL_PORT=3306
BANK_DEFAULT_PASSWORD=replace-with-a-long-local-password
MONGO_PORT=27017
MONGODB_URI=mongodb://localhost:27017/minibanckito
MONGODB_DATABASE=minibanckito
BANK_COMPANY_TRANSFER_APPROVAL_THRESHOLD=5000000

# Company association for business users (change for each real company)
BANK_SECURITY_COMPANY_COMPANY_CUSTOMER=COMPANY001
BANK_SECURITY_COMPANY_COMPANY_OPERATOR=COMPANY001
BANK_SECURITY_COMPANY_COMPANY_SUPERVISOR=COMPANY001
